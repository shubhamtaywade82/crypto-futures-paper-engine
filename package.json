{
  "name": "crypto-futures-paper-engine",
  "version": "1.0.0",
  "description": "Crypto futures paper trading engine: Binance market data + simulated CoinDCX futures execution",
  "type": "module",
  "main": "dist/engine.js",
  "scripts": {
    "dev": "tsx watch src/cli.ts",
    "build": "tsc",
    "start": "node dist/cli.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "paper:trade": "tsx src/cli.ts trade",
    "paper:monitor": "tsx src/cli.ts monitor",
    "paper:backtest": "tsx src/cli.ts backtest"
  },
  "keywords": [
    "paper-trading",
    "binance",
    "coindcx",
    "crypto",
    "futures"
  ],
  "license": "MIT",
  "dependencies": {
    "@nemesis-oss/binance-sdk": "file:../sdk/binance-client-ts",
    "uuid": "^9.0.1",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.10",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
